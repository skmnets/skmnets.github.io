@article{mishra2026normalized,
  abbr={LoG 2026},
  bibtex_show={true},
  title={Normalized Routing Limits for Pruned Neural Networks: NNGP and NTK across Density Regimes},
  author={Mishra, Siddhi Kanta and Garibay, Ivan},
  journal={Learning on Graphs Conference (LoG)},
  series={Proceedings of Machine Learning Research (PMLR)},
  note={Accepted at the Learning on Graphs Conference (LoG 2026); forthcoming in PMLR.},
  year={2026},
  category={conference},
  selected={true},
  abstract={A binary pruning mask encodes which synaptic connections are retained or removed in a neural network and can be viewed as the biadjacency matrix of a directed bipartite graph. When retained density vanishes, its raw step graphon collapses in L¹, even though each neuron may still aggregate a growing, structured neighborhood. We show that under local retained-fan-in scaling, the network instead sees the row-Markov routing operator P = D⁻¹M, which records the relative allocation of retained inputs. For two-hidden-layer networks with independent row-constrained block masks and growing minimum fan-in, we derive deterministic finite-dimensional NNGP covariance and initialization-time NTK limits across fixed- and vanishing-density regimes, prove density invariance, identify block-mass adjoints governing backward sensitivity, and resolve forward–backward weight reuse via Gaussian-conditioning decoupling.}
}

@article{mishra2026community,
  abbr={LoG 2026},
  bibtex_show={true},
  title={Community Information Horizons in Discrete Graph Diffusion: A Graphon Analysis},
  author={Mishra, Siddhi Kanta and Garibay, Ivan},
  journal={Learning on Graphs Conference (LoG)},
  series={Proceedings of Machine Learning Research (PMLR)},
  note={Accepted at the Learning on Graphs Conference (LoG 2026); forthcoming in PMLR.},
  year={2026},
  category={conference},
  selected={true},
  abstract={At what noise level does a corrupted graph stop identifying the structure that generated it? We show that the answer depends on graph size, not diffusion time alone. Under binary edge refresh, every dense probability graphon follows the exact population trajectory Wₜ = ρ + ᾱₜ(W₀ - ρ). To determine when a finite graph can still resolve the contracted structure, we specialize to stochastic block graphons and define the size-aware structural signal-to-noise ratio zₜ. This separates three recovery regimes: weak detection begins at zₜ = 1, consistency requires zₜ → ∞, and exact recovery occurs at zₜ² ≍ log n. Reverse diffusion paths expose an alignment switch: crossing the source-information horizon causes reverse chains to lose alignment with the specific source partition while synthesizing fresh, coherent population-level community modes.}
}

@article{mishra2026learning_gnn,
  abbr={Preprint},
  bibtex_show={true},
  title={Learning Where to Communicate in GNNs: Task-Conditioned Edge Scores Across Graph Sizes},
  author={Mishra, Siddhi Kanta and Garibay, Ivan},
  journal={Manuscript under review at ICLR 2027},
  note={Manuscript under review at ICLR 2027},
  year={2026},
  category={manuscript},
  selected={true},
  abstract={Graph neural networks succeed by moving information across edges, but which communication routes are actually useful for a given task? We develop a task-conditioned edge score that describes whether strengthening or weakening a route would locally improve the objective. The score couples the representation difference exchanged across a route with a backward sensitivity describing how that exchange affects the task, gated by activation derivatives. This allows useful heterophilous as well as homophilous communication. Graph limits provide a common population coordinate system for comparing these scores across resolutions. For nonlinear residual message passing with symmetric mean-normalized difference aggregation, we derive the exact score and prove finite-horizon consistency of topology learning. On METR-LA, scores from independently trained smaller models guide useful interventions on a larger frozen predictor.}
}

@inproceedings{ornee2026mocdiff,
  abbr={ICMLW 2026},
  bibtex_show={true},
  title={MoCDiff: Efficient Motif-Constrained Discrete Diffusion for Molecule Generation},
  author={Ornee, Tasfia Nuzhat and Basher, Mohammad Jahid Ibna and Mishra, Siddhi Kanta and Garibay, Ozlem and Garibay, Ivan and Yousefi, Niloofar},
  booktitle={ICML 2026 Workshop on Generative and Agentic AI for Biology},
  year={2026},
  category={workshop},
  selected={true},
  abstract={Molecular graph generation requires models that capture chemical structure while producing valid, diverse, and novel molecules within practical sampling budgets. We present MoCDiff, a Motif-Constrained masked Discrete Diffusion framework built on two complementary components: mSENT, a motif-aware graph-to-sequence tokenizer that biases graph traversal toward chemically coherent substructures while preserving exact graph decodability, and an optimized constrained sampler with inexact ALM updates, conditionally adaptive penalties, and lazy enforcement. On QM9, mSENT raises validity from 85.3% to 90.5% and uniqueness from 75.0% to 97.7% over standard SENT, while achieving a 1.62× speedup and 1.7× higher accepted-sample throughput over baseline CDD.}
}

