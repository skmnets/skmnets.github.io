@article{mishra2026normalized,
  abbr={LoG 2026},
  bibtex_show={true},
  title={Normalized Routing Limits for Pruned Neural Networks},
  author={Mishra, Siddhi Kanta and Garibay, Ivan},
  journal={Learning on Graphs Conference (LoG)},
  series={Proceedings of Machine Learning Research (PMLR)},
  year={2026},
  selected={true},
  abstract={We develop a graph-limit framework for width-growing sparse neural networks in which ordinary adjacency graphons collapse under vanishing density while normalized routing operators retain nontrivial structure. We derive limiting NNGP covariance and Neural Tangent Kernel recursions for structured sparse masks and establish sparse stochastic-block and random-pruning regimes where normalized graphlet operators preserve meaningful block and spectral structure.}
}

@article{mishra2026community,
  abbr={LoG 2026},
  bibtex_show={true},
  title={Community Information Horizons in Discrete Graph Diffusion: A Graphon Analysis},
  author={Mishra, Siddhi Kanta and Garibay, Ivan},
  journal={Learning on Graphs Conference (LoG)},
  series={Proceedings of Machine Learning Research (PMLR)},
  year={2026},
  selected={true},
  abstract={We connect edge-wise graph corruption to an exact trajectory in graphon space and characterize contraction of community and spectral modes under discrete graph diffusion. We derive finite-size structural signal-to-noise coordinates linking graph size, corruption level, and recoverability, yielding size-dependent information horizons for denoising with cross-size collapse and zero-shot transfer.}
}

